#include <stdio.h>
int main()
{
    int num[6];

    printf("Ingrese 6 números enteros:\n");
    for (int i = 0; i < 6; ++i) {
        printf("Número %d: ", i+1);
        scanf("%d", &num[i]);
    }
    printf("\nLos números ingresados son:\n");
    for (int i = 0; i < 6; ++i) {
        printf("%d ", num[i]);
    }
    printf("\n");

    return 0;
}