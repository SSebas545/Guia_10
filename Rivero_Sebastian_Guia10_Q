#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

int cargarFecha(int *dia, int *mes, int *anio)
{
    time_t t = time(NULL);
    struct tm tm = *localtime(&t);
    int diaActual = tm.tm_mday;
    int mesActual = tm.tm_mon + 1; 
    int anioActual = tm.tm_year + 1900; 

    do {
        printf("Ingrese el día (1-31): ");
        scanf("%d", dia);
        printf("Ingrese el mes (1-12): ");
        scanf("%d", mes);
        printf("Ingrese el año: ");
        scanf("%d", anio);

        if (*anio > anioActual || (*anio == anioActual && *mes > mesActual) || (*anio == anioActual && *mes == mesActual && *dia > diaActual)) {
            printf("La fecha ingresada no puede ser posterior a la fecha actual. Intente nuevamente.\n");
        } else if (*dia < 1 || *dia > 31 || *mes < 1 || *mes > 12) {
            printf("Fecha inválida. Intente nuevamente.\n");
        } else {
            break; 
        }
    } while (1);

    return 0;
}

void modificarFecha(char nombre[3][20], int fecha[3][3])
{
    char nombreBuscado[20];
    printf("Ingrese el nombre de la persona cuya fecha desea modificar: ");
    scanf("%s", nombreBuscado);

    for (int i = 0; i < 3; i++) {
        if (strcmp(nombre[i], nombreBuscado) == 0) {
            printf("Modificando fecha para %s:\n", nombre[i]);
            cargarFecha(&fecha[i][0], &fecha[i][1], &fecha[i][2]);
            return;
        }
    }
    printf("Nombre no encontrado.\n");
}

