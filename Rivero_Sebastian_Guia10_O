#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main()
{
        char texto[100];
        int vocales[5] = {0}; 
        
        printf("Ingrese un texto: ");
        fgets(texto, sizeof(texto), stdin);
        
        for (int i = 0; texto[i] != '\0'; i++) {
                char c = texto[i];
                if (c == 'A' || c == 'a') {
                vocales[0]++;
                } else if (c == 'E' || c == 'e') {
                vocales[1]++;
                } else if (c == 'I' || c == 'i') {
                vocales[2]++;
                } else if (c == 'O' || c == 'o') {
                vocales[3]++;
                } else if (c == 'U' || c == 'u') {
                vocales[4]++;
                }
        }
        
        printf("Cantidad de veces que se repite cada vocal:\n");
        printf("A: %d\n", vocales[0]);
        printf("E: %d\n", vocales[1]);
        printf("I: %d\n", vocales[2]);
        printf("O: %d\n", vocales[3]);
        printf("U: %d\n", vocales[4]);
        
        return 0;
}