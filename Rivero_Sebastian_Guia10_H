#include <stdio.h>

int main() 
{
    int vector[7];
    int temp;
    printf("Ingrese 7 números enteros positivos:\n");
    for (int i = 0; i < 7; i++) {
        printf("Elemento %d: ", i + 1);
        scanf("%d", &vector[i]);
    }

    for (int i = 0; i < 7 - 1; i++) {
        for (int j = i + 1; j < 7; j++) {
            if (vector[i] > vector[j]) {
                temp = vector[i];
                vector[i] = vector[j];
                vector[j] = temp;
            }
        }
    }

    printf("Vector ordenado de menor a mayor:\n");
    for (int i = 0; i < 7; i++) {
        printf("%d ", vector[i]);
    }
    printf("\n");

    return 0;
}
