#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main()
{
    char texto[100];
    printf("Ingrese un texto: ");
    fgets(texto, sizeof(texto), stdin);

    printf("Texto invertido: ");
    for (int i = 0; texto[i] != '\0'; i++) {
        char c = texto[i];
        if (c >= 'A' && c <= 'Z') {
            c = c + ('a' - 'A');
        } else if (c >= 'a' && c <= 'z') {
            c = c - ('a' - 'A');
        }
        printf("%c", c);
    }
    printf("\n");
    return 0;
}