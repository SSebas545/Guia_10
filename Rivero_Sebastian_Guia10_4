#include <stdio.h>

int main()
{
    int pares[20], impares[20];
    int num, iPares = 0, iImpares = 0;

    while (1) {
        printf("Ingrese un número (0 para finalizar): ");
        scanf("%d", &num);

        if (num == 0) {
            break;
        }

        if (num % 2 == 0) {
            if (iPares < 20) {
                pares[iPares++] = num;
            } else {
                printf("El vector de pares está lleno.\n");
                break;
            }
        } else {
            if (iImpares < 20) {
                impares[iImpares++] = num;
            } else {
                printf("El vector de impares está lleno.\n");
                break;
            }
        }
    }

    printf("Números pares ingresados:\n");
    for (int i = 0; i < iPares; i++) {
        printf("%d ", pares[i]);
    }
    printf("\n");

    printf("Números impares ingresados:\n");
    for (int i = 0; i < iImpares; i++) {
        printf("%d ", impares[i]);
    }
    printf("\n");

    return 0;
}